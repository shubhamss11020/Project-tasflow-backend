      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User & Org",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.tokens.refreshToken);",
                  "    pm.collectionVariables.set('orgId', jsonData.organization.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.morgan@taskflow.dev\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"orgName\": \"Apex Solutions\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
